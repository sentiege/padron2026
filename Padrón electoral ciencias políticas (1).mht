@charset "utf-8";

* { box-sizing: border-box; }

body { margin: 0px; font-family: system-ui, sans-serif; color: rgb(67, 39, 25); background: rgb(255, 248, 242); min-height: 100vh; display: flex; flex-direction: column; }

header { background: rgb(194, 65, 12); color: rgb(255, 255, 255); padding: 42px 24px 75px; }

.wrap, main { max-width: 960px; margin: auto; }

h1 { font-size: clamp(28px, 5vw, 42px); margin: 16px 0px; }

header p { color: rgb(255, 237, 213); }

main { width: 100%; padding: 0px 20px 35px; flex: 1 1 0%; }

.panel { background: rgb(255, 255, 255); border: 1px solid rgb(254, 215, 170); border-radius: 18px; padding: 24px; margin-top: -35px; box-shadow: rgba(154, 52, 18, 0.063) 0px 12px 30px; }

label { display: block; font-weight: 650; margin-bottom: 12px; }

.controls { display: flex; gap: 10px; }

input, button, select { font: inherit; padding: 14px; border-radius: 10px; }

input { min-width: 0px; flex: 1 1 0%; border: 1px solid rgb(228, 189, 161); }

button { background: rgb(194, 65, 12); color: white; border: 0px; cursor: pointer; font-weight: 650; }

button:hover { background: rgb(154, 52, 18); }

input:focus, select:focus, button:focus-visible { outline: rgb(251, 146, 60) solid 3px; outline-offset: 2px; }

.hint, .stats { color: rgb(128, 98, 79); font-size: 13px; line-height: 1.6; }

.filters { display: flex; justify-content: space-between; gap: 10px; margin-top: 18px; }

select { background: white; border: 1px solid rgb(254, 215, 170); color: rgb(67, 39, 25); }

.secondary { background: rgb(255, 237, 213); color: rgb(154, 52, 18); }

.secondary:hover { background: rgb(254, 215, 170); }

.stats { margin: 24px 0px; }

.head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 24px 0px 16px; }

h2 { font-size: 19px; margin: 0px; }

#status { font-size: 13px; color: rgb(128, 98, 79); }

.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

.card { background: white; border: 1px solid rgb(254, 215, 170); border-radius: 16px; padding: 22px; }

.top { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; }

.badge { background: rgb(255, 237, 213); color: rgb(154, 52, 18); padding: 6px 10px; border-radius: 8px; font-weight: 700; }

.order { padding-top: 6px; color: rgb(128, 98, 79); }

h3 { font-size: 16px; line-height: 1.5; margin: 18px 0px; overflow-wrap: anywhere; }

.doc { border-top: 1px solid rgb(255, 240, 228); padding-top: 14px; display: flex; justify-content: space-between; gap: 10px; }

.doc span { font-size: 13px; color: rgb(128, 98, 79); }

.empty { text-align: center; padding: 35px 20px; background: rgb(255, 237, 213); border: 1px dashed rgb(253, 186, 116); border-radius: 16px; color: rgb(128, 98, 79); line-height: 1.7; }

#more { margin-top: 18px; }

footer { text-align: center; padding: 24px; border-top: 1px solid rgb(254, 215, 170); color: rgb(128, 98, 79); font-size: 13px; }

[hidden] { display: none !important; }

@media (max-width: 600px) {
  .controls { flex-wrap: wrap; }
  input, .controls button { width: 100%; flex-basis: 100%; }
  .grid { grid-template-columns: 1fr; }
  .head { flex-direction: column; align-items: flex-start; }
  .panel { padding: 20px; }
}
